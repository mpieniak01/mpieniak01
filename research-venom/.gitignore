# Research-Venom local artifacts
__pycache__/
*.pyc
*.pyo
*.tmp
*.log

# Python env/cache
.venv/
.pytest_cache/
.mypy_cache/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime outputs generated by scripts
produkty/meta/export_report.json
produkty/meta/export_report.md
produkty/meta/*.tmp
produkty/excel/workspace/*_tmp.xlsx

# Secrets / credentials (never publish)
.env
.env.*
secrets/
**/secrets/
*secret*
*token*
*credential*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Keep final products versioned by explicit decision
# (do not blanket-ignore produkty/word or produkty/excel here)
