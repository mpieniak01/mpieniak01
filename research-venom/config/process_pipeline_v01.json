{
  "project": {
    "name": "research-venom",
    "config_version": "v01",
    "artifact_contract": "process-first",
    "migration_phase": "G1_process_manifest"
  },
  "roots": {
    "repo_root": ".",
    "artifacts_root": "artifacts",
    "runtime_root": "_external/not_tracked"
  },
  "runtime": {
    "step_timeout_sec": 600,
    "cleanup_office_orphans": true,
    "skip_bookmark_insert": false
  },
  "process": {
    "model": "input -> processing -> result",
    "sequence": [
      "sonar_market",
      "github_market",
      "github_pr_flow",
      "github_pr_comments",
      "visualization_sources_pack",
      "visualization_summary_tables",
      "visualization_pipeline"
    ],
    "steps": {
      "sonar_market": {
        "domain": "sonar_market",
        "kind": "input",
        "env_file": ".env.dev",
        "token_env": "SONAR_TOKEN",
        "paths": {
          "project_key_file": "artifacts/inputs/sonar_market/project_keys_selected_v01.txt",
          "output_json": "artifacts/products_light/sonar_market/benchmark_analysis_2026_v01.json",
          "output_md": "artifacts/products_light/sonar_market/benchmark_analysis_2026_v01.md",
          "timeseries_dir": "artifacts/sources/sonar_market/timeseries",
          "aggregate_csv": "artifacts/products_light/sonar_market/timeseries_agg_2026_v01.csv"
        }
      },
      "github_market": {
        "domain": "github_market",
        "kind": "input",
        "env_file": ".env.dev",
        "token_env": "GITHUB_TOKEN",
        "paths": {
          "repo_file": "artifacts/inputs/github_market/repo_keys_selected_v01.txt",
          "selection_json": "artifacts/sources/github_market/repo_selection_v01.json",
          "selection_md": "artifacts/sources/github_market/repo_selection_v01.md",
          "selection_keys": "artifacts/inputs/github_market/repo_keys_selected_v01.txt",
          "output_json": "artifacts/products_light/github_market/benchmark_analysis_2026_v01.json",
          "output_md": "artifacts/products_light/github_market/benchmark_analysis_2026_v01.md",
          "aggregate_csv": "artifacts/products_light/github_market/timeseries_agg_2026_v01.csv",
          "per_repo_dir": "artifacts/sources/github_market/per_repo"
        }
      },
      "github_pr_flow": {
        "domain": "pr_flow",
        "kind": "processing",
        "owner": "mpieniak01",
        "repo": "Venom",
        "env_file": ".env.dev",
        "token_env": "GITHUB_TOKEN",
        "paths": {
          "output_root": "artifacts/sources/pr_flow/per_repo",
          "aggregate_csv": "artifacts/products_light/pr_flow/timeseries_agg_2026_v01.csv",
          "output_json": "artifacts/products_light/pr_flow/analysis_2026_v01.json",
          "output_md": "artifacts/products_light/pr_flow/analysis_2026_v01.md"
        }
      },
      "github_pr_comments": {
        "domain": "pr_comments",
        "kind": "processing",
        "owner": "mpieniak01",
        "repo": "Venom",
        "env_file": ".env.dev",
        "token_env": "GITHUB_TOKEN",
        "paths": {
          "output_json": "artifacts/products_light/pr_comments/analysis_2026_v01.json",
          "output_md": "artifacts/products_light/pr_comments/analysis_2026_v01.md",
          "daily_csv": "artifacts/products_light/pr_comments/comments_daily_2026_v01.csv",
          "summary_csv": "artifacts/products_light/pr_comments/comments_summary_2026_v01.csv"
        }
      },
      "visualization_sources_pack": {
        "domain": "visualization",
        "kind": "processing",
        "paths": {
          "in_205b": "artifacts/products_light/sonar_market/timeseries_agg_2026_v01.csv",
          "in_205c": "artifacts/products_light/github_market/timeseries_agg_2026_v01.csv",
          "in_205d": "artifacts/products_light/pr_flow/timeseries_agg_2026_v01.csv",
          "in_205e_daily": "artifacts/products_light/pr_comments/comments_daily_2026_v01.csv",
          "layout_csv": "artifacts/inputs/visualization/excel_sheet_layout_v02.csv",
          "out_json": "artifacts/processing/visualization/sources_pack_v01.json",
          "out_csv": "artifacts/processing/visualization/sources_pack_v01.csv"
        }
      },
      "visualization_summary_tables": {
        "domain": "visualization",
        "kind": "processing",
        "paths": {
          "in_pack_json": "artifacts/processing/visualization/sources_pack_v01.json",
          "chart_spec_json": "artifacts/inputs/visualization/chart_spec_v02.json",
          "out_summary_csv": "artifacts/processing/visualization/summary_tables_v01.csv"
        }
      },
      "visualization_pipeline": {
        "domain": "visualization",
        "kind": "result",
        "paths": {
          "sources_pack_json": "artifacts/processing/visualization/sources_pack_v01.json",
          "summary_csv": "artifacts/processing/visualization/summary_tables_v01.csv",
          "excel_layout_csv": "artifacts/inputs/visualization/excel_sheet_layout_v02.csv",
          "workbook_layout_json": "artifacts/inputs/visualization/workbook_layout_v02.json",
          "chart_spec_json": "artifacts/inputs/visualization/chart_spec_v02.json",
          "chart_style_profile_json": "artifacts/inputs/visualization/chart_style_profile_v02.json",
          "patterns_doc_md": "docs/EXCEL_ADVANCED_PATTERNS.md",
          "excel_workbook": "_external/not_tracked/visualization/workbook_v02.xlsx",
          "excel_verify_json": "artifacts/products_light/visualization/excel_verify_v02.json",
          "excel_verify_md": "artifacts/products_light/visualization/excel_verify_v02.md",
          "word_map_csv": "artifacts/inputs/visualization/word_embed_map_v02.csv",
          "word_input_docx": "_external/not_tracked/visualization/embed_canvas_v02.docx",
          "word_output_docx": "_external/not_tracked/visualization/embed_canvas_bookmarked_v02.docx",
          "embed_run_json": "artifacts/products_light/visualization/word_embed_run_v02.json",
          "embed_run_md": "artifacts/products_light/visualization/word_embed_run_v02.md",
          "embed_verify_json": "artifacts/products_light/visualization/word_embed_verify_v02.json",
          "embed_verify_md": "artifacts/products_light/visualization/word_embed_verify_v02.md",
          "pipeline_report_json": "artifacts/products_light/visualization/pipeline_run_v02.json",
          "pipeline_report_md": "artifacts/products_light/visualization/pipeline_run_v02.md"
        }
      }
    }
  },
  "paths": {
    "sources_pack_json": "artifacts/processing/visualization/sources_pack_v01.json",
    "summary_csv": "artifacts/processing/visualization/summary_tables_v01.csv",
    "excel_layout_csv": "artifacts/inputs/visualization/excel_sheet_layout_v02.csv",
    "workbook_layout_json": "artifacts/inputs/visualization/workbook_layout_v02.json",
    "chart_spec_json": "artifacts/inputs/visualization/chart_spec_v02.json",
    "chart_style_profile_json": "artifacts/inputs/visualization/chart_style_profile_v02.json",
    "patterns_doc_md": "docs/EXCEL_ADVANCED_PATTERNS.md",
    "excel_workbook": "_external/not_tracked/visualization/workbook_v02.xlsx",
    "excel_verify_json": "artifacts/products_light/visualization/excel_verify_v02.json",
    "excel_verify_md": "artifacts/products_light/visualization/excel_verify_v02.md",
    "word_map_csv": "artifacts/inputs/visualization/word_embed_map_v02.csv",
    "word_input_docx": "_external/not_tracked/visualization/embed_canvas_v02.docx",
    "word_output_docx": "_external/not_tracked/visualization/embed_canvas_bookmarked_v02.docx",
    "embed_run_json": "artifacts/products_light/visualization/word_embed_run_v02.json",
    "embed_run_md": "artifacts/products_light/visualization/word_embed_run_v02.md",
    "embed_verify_json": "artifacts/products_light/visualization/word_embed_verify_v02.json",
    "embed_verify_md": "artifacts/products_light/visualization/word_embed_verify_v02.md",
    "pipeline_report_json": "artifacts/products_light/visualization/pipeline_run_v02.json",
    "pipeline_report_md": "artifacts/products_light/visualization/pipeline_run_v02.md"
  },
  "profiles": {
    "export": {
      "full": [
        "README.md",
        ".gitignore",
        ".github/copilot-instructions.md",
        ".github/workflows/scripts-review-ci.yml",
        "tools/*.py",
        "tools/*.ps1",
        "config/process_pipeline_v01.json",
        "docs/*.md",
        "artifacts/inputs/*",
        "artifacts/analysis/*",
        "artifacts/timeseries_agg/*",
        "artifacts/meta/*",
        "artifacts/sources/*",
        "artifacts/processing/*",
        "artifacts/products_light/*"
      ],
      "scripts_review": [
        "README.md",
        ".gitignore",
        ".github/copilot-instructions.md",
        ".github/workflows/scripts-review-ci.yml",
        "tools/*.py",
        "tools/*.ps1",
        "config/process_pipeline_v01.json",
        "docs/SCRIPTS_REFERENCE.md",
        "docs_pr/_arch/SCRIPTS_MIGRATION_206G.md",
        "docs/EXECUTION_ENV.md",
        "docs_pr/_arch/ARTIFACT_CONTRACT_205H.md"
      ]
    }
  }
}
